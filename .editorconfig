# EditorConfig 统一多编辑器/IDE 的基础排版约定
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,ts,vue,css,html}]
indent_size = 2

# Windows 脚本需 CRLF（与 .gitattributes 保持一致）
[*.{ps1,cmd,bat}]
end_of_line = crlf

[*.{sh,sql,cnf}]
end_of_line = lf
