# jd 项目 mysqld-exporter 连接配置（按容器名直连）—— 备选方式
#
# 默认已改用环境变量注入（见 docker-compose.exporters-only.yml 的 DATA_SOURCE_NAME），
# 本文件**不会**被自动挂载。仅当口令含 @ ( ) / 等特殊字符时才改回文件方式：
#     command: ['--config.my-cnf=/etc/mysql-exporter/my.cnf']
#     volumes:
#       - ./deploy/jd-exporters/my.by-container.cnf:/etc/mysql-exporter/my.cnf:ro
# 与 my.cnf 的区别：host 用 container_name（interview-mysql），跨 compose 项目可解析。
# 与 my.cnf 的区别：host 使用 jd MySQL 容器的 container_name（interview-mysql），
# 因此在外部 compose 项目里跨网接入时也能解析。
# 口令必须与 init/01-monitor-user.sql 中的 exporter 账号口令一致。
# 注意：含明文口令，生产请改为环境变量注入或限制权限（0600）。

[client]
user = exporter
password = exporter_change_me
host = interview-mysql
port = 3306
