# jd 项目 mysqld-exporter 连接配置（只读监控账号）—— 备选方式
#
# 默认已改用环境变量注入，本文件**不会**被自动挂载：
#   environment:
#     DATA_SOURCE_NAME: exporter:${MYSQL_EXPORTER_PASSWORD}@(mysql:3306)/
#
# 仅当口令含 @ ( ) / 等特殊字符导致 DATA_SOURCE_NAME 解析失败时，
# 才改回文件方式：把 docker-compose.jd.yml 里 mysqld-exporter 的 environment 换成
#     command: ['--config.my-cnf=/etc/mysql-exporter/my.cnf']
#     volumes:
#       - ./deploy/jd-exporters/my.cnf:/etc/mysql-exporter/my.cnf:ro
# 原挂载位置见 deploy/jd-exporters/docker-compose.jd.yml。
# 口令必须与 init/01-monitor-user.sql 中的 exporter 账号口令一致。
# 注意：含明文口令，生产请改为环境变量注入或限制文件权限（0600）。
# host 指向 compose 服务名 mysql（同网络内解析）。

[client]
user = exporter
password = exporter_change_me
host = mysql
port = 3306
