# 一键部署环境变量样例：复制为 .env 后按需修改。
# 生产环境必须替换全部默认密码与密钥。

# ---------- 数据库 ----------
DB_USER=mwo
DB_PASSWORD=mwo_change_me
DB_NAME=middleware_ops

# ---------- 缓存 ----------
REDIS_PASSWORD=redis_change_me

# ---------- 平台 ----------
APP_MODE=release
WEB_PORT=8000
PROMETHEUS_PORT=9090
# 监控大盘（平台统一托管；被管项目不再需要自带 Grafana）
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=grafana_change_me
LOG_LEVEL=info

# JWT 密钥：≥32 位随机字符串（可用 openssl rand -base64 48 生成）
JWT_SECRET=please_replace_with_a_random_48_byte_string

# 主密钥：AES-256-GCM 加密连接密码等敏感数据；留空则由容器内密钥文件生成
MASTER_KEY=

# 初始管理员（首次启动自动创建，登录后请立即改密）
ADMIN_USER=admin
ADMIN_PASSWORD=Admin@12345

# 日志/告警上报 Hook 令牌（应用直推 /api/hooks/* 时携带，也是 Filebeat 包分发的校验令牌）
HOOK_TOKEN=

# ---------- 日志总线 Kafka（日志集成：Filebeat → 平台 Kafka → 平台消费）----------
# 详见 docs/LOG_INTEGRATION.md。平台自带的 Kafka 是「日志集成」的必备组件。
KAFKA_ENABLED=true
# 平台后端消费用 INTERNAL 监听器（容器网络），一般不需要改
KAFKA_BROKERS=kafka:29092
KAFKA_LOG_TOPIC=mwops-logs
KAFKA_GROUP_ID=mwops-log-ingest
KAFKA_PORT=9092

# 【最容易配错的一处】**被管服务器能访问到的平台地址**：填平台宿主机的 IP 或域名。
# 它会被写入 Kafka 的 advertised EXTERNAL 监听器，并渲染进目标机 Filebeat 的 hosts。
# 填 localhost/127.0.0.1 只有"平台与被管机同一台机器"时才对：
# 其他机器上的 Filebeat 会握手成功、随后被引导连它自己的 127.0.0.1 而失败
#   dial tcp 127.0.0.1:9092: connect: connection refused
# 集成中心的「日志集成 → 自检」第 2 段专门判定这个地址；平台的预览/部署/重新应用
# 也会**直接拒绝**"目标是远程机器 + 这里还是回环/容器名"的组合（INC-028），
# 因为这种组合 100% 收不到日志，而失败现场在对方机器上、报错还会伪装成网络问题。
# 取本机 IP：ip route get 1 | awk '{print $7; exit}'   或   hostname -I | awk '{print $1}'
KAFKA_ADVERTISED_HOST=127.0.0.1

# Kafka 分区数（消费并行度）与日志在总线上的保留时长（小时）
KAFKA_NUM_PARTITIONS=3
KAFKA_LOG_RETENTION_HOURS=72
# KRaft 集群 ID；换值等于换集群，已有 kafka-data 卷会拒绝挂载，一般不要改
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# 目标机上安装的 Filebeat 版本（平台用 Ansible 安装，已安装则跳过）
FILEBEAT_VERSION=8.16.0

# ---------- 日志告警：默认规则与后处理 ----------
# 规则本身在页面「日志告警规则」里配（按服务/指纹/级别匹配）；
# 下面这些是**没有命中任何规则时**的兜底值，以及后处理的限流参数。
LOG_ALERT_DEDUP_WINDOW=5        # 默认去重窗口（分钟）：窗口内同指纹只合并计数
LOG_ALERT_COOLDOWN=10           # 默认冷却期（分钟）：冷却内不通知、不触发 AI（事件仍记录）
LOG_ALERT_AI_ENABLED=true       # 默认是否自动做 AI 代码分析
LOG_ALERT_WORKER_INTERVAL=15    # 后处理扫描间隔（秒）
LOG_ALERT_WORKER_BATCH=10       # 每轮最多处理多少条（AI 分析很贵，靠它限流）
LOG_ALERT_ANALYZE_TIMEOUT=2m    # 单条事件的 AI 分析超时

# ---------- 外部 AI 分析服务（日志告警用）----------
# 平台不再 clone 任何代码仓库：把「问题」（脱敏后的错误信息 + 堆栈）提交给 AI 服务，
# 由它做代码分析并通过回调/轮询把结论送回来。
# 默认关闭：不配地址就不做 AI 分析（事件会明确标记未启用，而不是假装能分析）。
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_BASE_URL=            # 例如 http://ai.internal:8000
AI_ANALYSIS_API_KEY=             # 放在 Authorization: Bearer 头里
AI_ANALYSIS_SUBMIT_PATH=/v1/analyses
AI_ANALYSIS_QUERY_PATH=/v1/analyses/{task_id}
# 回调地址必须是 AI 服务能访问到的平台地址（含域名/端口，反向代理后填对外地址）
AI_ANALYSIS_CALLBACK_URL=
# 回调令牌：不配置则拒绝所有回调（结论改由轮询兜底）
AI_ANALYSIS_CALLBACK_TOKEN=
AI_ANALYSIS_TASK_TIMEOUT=30m     # 超过它仍没有结论就按超时收尾
AI_ANALYSIS_POLL_INTERVAL=60s    # 轮询兜底间隔（回调正常时它只是保险）

# ---------- AI 引擎 ----------
# 已改为**平台内管理**：登录平台 →「AI 设置」里配置策略、提供方、API Key、模型与 token 额度，
# 保存即时生效（密钥 AES-256-GCM 加密落库，界面只回显掩码），不需要改这里、也不需要重建容器。
#
# 下面这些变量仅作**首次启动时的一次性导入**：平台第一次启动时若数据库里还没有 AI 设置，
# 会把这里的非空值导入平台并写一条启动日志；之后以平台内的配置为准（改这里不会再生效）。
# 想跳过导入，留空即可。
AI_STRATEGY=hybrid
THIRD_PARTY_ENABLED=false
THIRD_PARTY_BASE_URL=https://api.deepseek.com/v1
# 建议留空：直接在平台「AI 设置」里填写，避免密钥散落在 .env
THIRD_PARTY_API_KEY=
THIRD_PARTY_MODEL=deepseek-chat
SELF_HOSTED_ENABLED=true
SELF_HOSTED_KIND=mock
# 自研/本地：kind=mock 表示内置确定性引擎（离线可用）；接入 Ollama/vLLM 时填 base_url
SELF_HOSTED_BASE_URL=
SELF_HOSTED_MODEL=qwen2.5:7b

# ---------- 出网合规（6.5）----------
# 逗号分隔的服务白名单；留空表示禁止任何第三方 AI 分析
OUTBOUND_WHITELIST=

# ---------- 通知渠道 ----------
# 同样已改为**平台内管理**：登录平台 →「通知渠道」里配置飞书/企微/钉钉/邮件的 webhook、
# 签名密钥与 @成员，并可逐个「发送测试」。下面的变量同样只是首次导入兜底，建议留空。
FEISHU_ENABLED=false
FEISHU_WEBHOOK=
WECOM_ENABLED=false
WECOM_WEBHOOK=

# ---------- 构建选项 ----------
# 需要 pgvector 原生向量类型与 HNSW 索引时设为 pgvector
GO_BUILD_TAGS=

# 远程安装 Exporter 需要镜像内有 ansible-playbook：默认已装（约 +200MB）。
# 只做本机 Docker 部署时设为 false 可让镜像明显变小、构建更快。
WITH_ANSIBLE=true

# 国内构建时 apk 拉包很慢，可换成国内 Alpine 源（留空用官方 CDN）：
#   ALPINE_MIRROR=mirrors.aliyun.com    或    mirrors.tuna.tsinghua.edu.cn
ALPINE_MIRROR=

# =============================================================================
# 接入外部项目（可选，以 jd 为例）
# 不需要互联网络、不需要对方改配置，详见 docs/GUIDE-JD-ONBOARD.md
# =============================================================================

# 指标数据源：默认用平台自带 Prometheus（集成中心拉起的 Exporter 由它抓取）
# 仅当接入「已存在的第三方 Prometheus」时才需要改成对方地址，例如
#   MWOPS_PROMETHEUS_BASE_URL=http://legacy-prometheus:9090
MWOPS_PROMETHEUS_BASE_URL=http://prometheus:9090

# 被管项目自建日志上报（非平台托管采集）时使用的服务令牌，
# 见 docs/COLLECTOR.md；平台托管的采集用上面的 HOOK_TOKEN。

# =============================================================================
# 集成中心（页面一键集成，详见 docs/INTEGRATION.md）
# =============================================================================

INTEGRATION_ENABLED=true
# 服务发现抓取任务名：集成的纳管实例 prom_job 会写成该值，
# 必须等于 deploy/prometheus/prometheus.yml 里的 middleware-integration。
INTEGRATION_JOB_NAME=middleware-integration
# 服务发现只读令牌（留空不鉴权）。接口 /api/sd/integrations 只暴露地址与标签，不含口令；
# 设置后需同步改 deploy/prometheus/prometheus.yml 的 url：...?token=<令牌>
INTEGRATION_SD_TOKEN=
# 集成成功后自动创建模板内的推荐告警规则
INTEGRATION_AUTO_RULES=true

# 一键拉起 Exporter / 代建只读监控账号（等价于云控制台的「一键安装」）
# 默认开启；docker-compose.yml 里 backend 已默认挂载 /var/run/docker.sock。
# 挂载 socket 等于把宿主机 root 权限交给平台容器——若合规不允许，
# 改成 false **并**注释掉 backend 的 docker.sock 挂载，平台会退化为手工执行模式。
# 注意：**日志集成的 Filebeat 不依赖 docker.sock**（它走 SSH + Ansible 到目标机），
# 因此即使关掉 docker 通道，日志集成依然可用。
INTEGRATION_DOCKER_ENABLED=true
INTEGRATION_DOCKER_HOST=unix:///var/run/docker.sock

# 宿主 docker 组的 GID：平台容器以非 root 用户运行，必须靠它才能读 /var/run/docker.sock。
# 取法：stat -c '%g' /var/run/docker.sock   或   getent group docker | cut -d: -f3
# setup-jd-link.sh 会自动探测并写入；Docker Desktop（macOS/Windows）通常无需设置。
DOCKER_GID=999

# Exporter 容器加入的网络（逗号分隔）：
#   第一个是监控面（Prometheus 所在网络）。
#   目标容器所在的网络**不需要**写在这里：集成时平台会自动发现并接入。
INTEGRATION_EXPORTER_NETWORK=middleware-ops_mwops

# ---------- 远程服务器安装 Exporter（Ansible）----------
# 集成时可选「部署位置＝远程服务器」（**默认就是远程**）：平台渲染内置 playbook，
# SSH 到目标机安装官方 Exporter。镜像默认已带 ansible-playbook（构建参数 WITH_ANSIBLE 默认 true）。
#
# 安全提示：远程安装会在**别的机器**上执行命令。默认开启是因为它是主功能；
# 若你的合规要求更严，把下面两项设为 false，并用 WITH_ANSIBLE=false 构建瘦身镜像
# （生产环境 env=prod 的集成本就会先创建审批工单，审批通过后才执行）。
INTEGRATION_ALLOW_REMOTE_INSTALL=true
INTEGRATION_ANSIBLE_ENABLED=true
# 远程安装方式：docker（官方镜像跑容器，默认）| docker-systemd（容器交 systemd 托管）
#                | binary（下载官方 release 二进制 + 原生 systemd，目标机无需 Docker）
INTEGRATION_ANSIBLE_INSTALL_MODE=docker
# docker 模式使用的网络：host（默认，端口即 Exporter 端口）或某张 bridge 网络
INTEGRATION_ANSIBLE_DOCKER_NETWORK=host
INTEGRATION_ANSIBLE_INSTALL_DIR=/opt/mwops-exporter
INTEGRATION_ANSIBLE_TIMEOUT=15m
INTEGRATION_ANSIBLE_BECOME=true
