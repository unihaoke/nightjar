# 一键部署环境变量样例：复制为 .env 后按需修改。
# 生产环境必须替换全部默认密码与密钥。

# ---------- 数据库 ----------
DB_USER=mwo
DB_PASSWORD=mwo_change_me
DB_NAME=middleware_ops

# ---------- 缓存 ----------
REDIS_PASSWORD=redis_change_me

# ---------- 平台 ----------
APP_MODE=release
WEB_PORT=8000
PROMETHEUS_PORT=9090
LOG_LEVEL=info

# JWT 密钥：≥32 位随机字符串（可用 openssl rand -base64 48 生成）
JWT_SECRET=please_replace_with_a_random_48_byte_string

# 主密钥：AES-256-GCM 加密连接密码等敏感数据；留空则由容器内密钥文件生成
MASTER_KEY=

# 初始管理员（首次启动自动创建，登录后请立即改密）
ADMIN_USER=admin
ADMIN_PASSWORD=Admin@12345

# 日志/告警上报 Hook 令牌（Agent 与应用调用 /api/hooks/* 时携带）
HOOK_TOKEN=

# ---------- AI 引擎 ----------
# third_party / self_hosted / hybrid
AI_STRATEGY=hybrid
THIRD_PARTY_ENABLED=false
THIRD_PARTY_BASE_URL=https://api.deepseek.com/v1
THIRD_PARTY_API_KEY=
THIRD_PARTY_MODEL=deepseek-chat
# 自研/本地：kind=mock 表示内置确定性引擎（离线可用）；接入 Ollama/vLLM 时填 base_url
SELF_HOSTED_ENABLED=true
SELF_HOSTED_KIND=mock
SELF_HOSTED_BASE_URL=
SELF_HOSTED_MODEL=qwen2.5:7b

# ---------- 出网合规（6.5）----------
# 逗号分隔的服务白名单；留空表示禁止任何第三方 AI 分析
OUTBOUND_WHITELIST=

# ---------- 通知渠道 ----------
FEISHU_ENABLED=false
FEISHU_WEBHOOK=
WECOM_ENABLED=false
WECOM_WEBHOOK=

# ---------- 构建选项 ----------
# 需要 pgvector 原生向量类型与 HNSW 索引时设为 pgvector
GO_BUILD_TAGS=

# =============================================================================
# 接入 jd 项目（可选）
# 配合 deploy/compose.jd-link.yml 使用，详见 docs/COLLECTOR-JD.md
# =============================================================================

# 跨项目专用互联网络名，必须与 jd 侧 .env 的 JD_NIGHTJAR_NETWORK 一致
JD_NIGHTJAR_NETWORK=jd-nightjar

# 指标数据源：走专用互联网络访问 jd 的 Prometheus（别名 jd-prometheus）
# 留空则由 deploy/compose.jd-link.yml 兜底为 http://jd-prometheus:9090
MWOPS_PROMETHEUS_BASE_URL=http://jd-prometheus:9090

# 与 jd 侧 .env 的 NIGHTJAR_HOOK_TOKEN 保持相同，否则 jd 的日志上报会被 401 拒绝
# 留空表示 Hook 不鉴权（仅测试用）
